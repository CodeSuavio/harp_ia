<section class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
  <h2 class="h6 fw-bold text-navy mb-3 text-uppercase tracking-wider">
    <i class="fa-solid fa-check-to-slot me-2 text-gold"></i>Como votou
  </h2>

  <% if overview.votes_count.zero? %>
    <p class="text-muted small mb-0">Nenhum voto registrado nas votações carregadas.</p>
  <% else %>
    <p class="small text-muted mb-2">
      <%= overview.votes_count %> votos em <%= overview.polls_voted %> votações carregadas
    </p>

    <div class="progress rounded-pill mb-3" style="height: 1.25rem;">
      <% overview.vote_breakdown.each do |label, count| %>
        <div class="progress-bar <%= vote_color(label) %>" role="progressbar"
             style="width: <%= bar_percent(count, overview.votes_count) %>%"
             title="<%= label %>: <%= count %>"></div>
      <% end %>
    </div>

    <ul class="list-unstyled d-flex flex-wrap gap-2 small mb-0">
      <% overview.vote_breakdown.each do |label, count| %>
        <li class="d-inline-flex align-items-center bg-light border rounded-pill px-3 py-1">
          <span class="badge rounded-circle <%= vote_color(label) %> p-1 me-2">&nbsp;</span>
          <span class="text-navy fw-medium me-1"><%= label %></span>
          <span class="text-muted"><%= count %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
