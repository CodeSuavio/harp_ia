<div class="container py-5">
  <h1 class="h3 mb-4">Deputados</h1>

  <%= turbo_frame_tag "deputies_list", data: { turbo_action: "advance" } do %>
    <%= form_with url: deputies_path, method: :get,
                  data: {
                    controller: "filter-form",
                    action: "input->filter-form#submit change->filter-form#submit"
                  },
                  class: "row g-3 align-items-center bg-white rounded-3 shadow-sm p-3 mb-4" do %>
      <div class="col-lg-4">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0">
            <i class="fa-solid fa-magnifying-glass text-muted"></i>
          </span>
          <%= text_field_tag :q, params[:q],
                id: "deputy-search",
                placeholder: "Nome do deputado ou sigla do partido...",
                class: "form-control border-start-0",
                data: { turbo_permanent: true } %>
        </div>
      </div>

      <div class="col-lg-2 col-md-6">
        <%= select_tag :state,
              options_for_select(
                [["Todos os estados", ""]] + @states.map { |s| ["#{s} (#{@state_counts[s].to_i})", s] },
                params[:state]
              ),
              class: "form-select" %>
      </div>

      <div class="col-lg-2 col-md-6">
        <% ordered_parties = @parties.sort_by { |p| [-@party_counts[p.id].to_i, p.label] } %>
        <%= select_tag :party,
              options_for_select(
                [["Todos os partidos", ""]] + ordered_parties.map { |p| ["#{p.label} (#{@party_counts[p.id].to_i})", p.id] },
                params[:party]
              ),
              class: "form-select" %>
      </div>

      <div class="col-lg-2 col-md-6">
        <% ordered_statuses = @statuses.sort_by { |s| [-@status_counts[s].to_i, s] } %>
        <%= select_tag :electoral_status,
              options_for_select(
                [["Todas as situações", ""]] + ordered_statuses.map { |s| ["#{s} (#{@status_counts[s].to_i})", s] },
                params[:electoral_status]
              ),
              class: "form-select" %>
      </div>

      <div class="col-lg-2 col-md-6">
        <%= select_tag :sort,
              options_for_select(
                [["Ordenar por nome", "name"], ["Ordenar por estado", "state"]],
                params[:sort]
              ),
              class: "form-select" %>
      </div>
    <% end %>

    <%= render "list" %>
  <% end %>
</div>
