<div class="container my-4">
  <h1 class="mb-4">Deputados</h1>

  <% if @deputies.empty? %>
    <p class="text-muted">Nenhum deputado cadastrado.</p>
  <% else %>
    <div class="row g-3">
      <% @deputies.each do |deputy| %>
        <div class="col-6 col-md-4 col-lg-3">
          <%= link_to deputy_path(deputy), class: "text-decoration-none text-reset" do %>
            <div class="card h-100">
              <% if deputy.photo_url.present? %>
                <%= image_tag deputy.photo_url, class: "card-img-top", alt: deputy.name %>
              <% end %>
              <div class="card-body">
                <h5 class="card-title"><%= deputy.name %></h5>
                <p class="card-text text-muted">
                  <%= deputy.party&.label %> · <%= deputy.state_label %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
