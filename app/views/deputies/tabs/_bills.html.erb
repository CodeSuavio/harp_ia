<% filter_params = { year: @bill_year, theme: @theme&.slug, keyword: @keyword }.compact %>

<!-- Resumo -->
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="p-4 bg-white rounded-4 shadow-sm border-start border-4 border-gold h-100">
      <span class="d-block text-muted small fw-bold text-uppercase mb-2 tracking-wider">
        Projetos apresentados
        <%= info_tip("Proposições em que o deputado é o autor principal. Quantidade não mede qualidade: muitos projetos são homenagens ou datas comemorativas.") %>
      </span>
      <span class="h3 fw-bold text-navy d-block"><%= @bills_total %></span>
      <% if (comparison = compared_to_average(@bills_total, @average_bills)) %>
        <span class="small text-muted"><%= comparison %> da Câmara (<%= @average_bills.to_s.tr(".", ",") %> por deputado)</span>
      <% end %>
    </div>
  </div>

  <div class="col-md-8">
    <div class="p-4 bg-white rounded-4 shadow-sm h-100">
      <span class="d-block text-muted small fw-bold text-uppercase mb-2 tracking-wider">
        Temas mais frequentes
        <%= info_tip("Classificação automática pelas palavras-chave e pela ementa dos projetos. Pode haver erros; confira o texto do projeto.") %>
      </span>
      <% if @themes.any? %>
        <div class="d-flex flex-wrap gap-1 mb-2">
          <% @themes.sort_by { |_, count| -count }.first(6).each do |theme, count| %>
            <%= link_to "#{theme.name} (#{count})",
                  deputy_tab_path(@deputy, "bills", filter_params.merge(theme: (theme.slug unless @theme == theme), page: nil)),
                  class: "badge badge-wrap text-decoration-none fw-medium #{@theme == theme ? 'text-bg-dark' : 'text-bg-light border text-navy'}",
                  aria: { pressed: @theme == theme } %>
          <% end %>
        </div>
      <% else %>
        <p class="small text-muted mb-2">Os projetos ainda não foram classificados por tema.</p>
      <% end %>

      <% if @top_keywords.any? %>
        <span class="d-block text-muted small mb-1">Palavras-chave recorrentes:</span>
        <div class="d-flex flex-wrap gap-1">
          <% @top_keywords.each do |keyword, count| %>
            <%= link_to "#{keyword} (#{count})",
                  deputy_tab_path(@deputy, "bills", filter_params.merge(keyword: (keyword unless @keyword == keyword), page: nil)),
                  class: "badge badge-wrap text-decoration-none fw-normal #{@keyword == keyword ? 'text-bg-dark' : 'text-bg-light border'}",
                  aria: { pressed: @keyword == keyword } %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h2 class="h6 fw-bold text-navy text-uppercase tracking-wider mb-0 me-2">Projetos de lei</h2>
    <span class="small text-muted"><%= @tab_total %> <%= "projeto".pluralize(@tab_total) %></span>
    <% if @theme %>
      <%= link_to "#{@theme.name} ×", deputy_tab_path(@deputy, "bills", filter_params.except(:theme)),
            class: "badge badge-wrap text-bg-light border text-decoration-none", aria: { label: "Remover filtro de tema #{@theme.name}" } %>
    <% end %>
    <% if @keyword %>
      <%= link_to "#{@keyword} ×", deputy_tab_path(@deputy, "bills", filter_params.except(:keyword)),
            class: "badge badge-wrap text-bg-light border text-decoration-none", aria: { label: "Remover filtro de palavra-chave #{@keyword}" } %>
    <% end %>
  </div>

  <% if @bill_years.size > 1 %>
    <div class="d-flex flex-wrap gap-2 mb-4">
      <%= link_to "Todos", deputy_tab_path(@deputy, "bills", filter_params.except(:year)),
            class: "btn btn-sm rounded-pill #{@bill_year ? 'btn-outline-secondary' : 'btn-dark'}" %>
      <% @bill_years.each do |year| %>
        <%= link_to year, deputy_tab_path(@deputy, "bills", filter_params.merge(year: year)),
              class: "btn btn-sm rounded-pill #{year == @bill_year ? 'btn-dark' : 'btn-outline-secondary'}" %>
      <% end %>
    </div>
  <% end %>

  <% if @bills.empty? %>
    <p class="text-muted text-center py-4 mb-0">Nenhum projeto de lei encontrado.</p>
  <% else %>
    <div class="list-group list-group-flush">
      <% @bills.each do |bill| %>
        <div class="list-group-item px-0 py-3">
          <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
            <%= link_to bill_path(bill), class: "fw-bold text-navy text-decoration-none", data: { turbo_frame: "_top" } do %>
              Proposição <%= bill.bill_number %>/<%= bill.year %>
            <% end %>
            <span class="small text-muted">
              <% if bill.submission_date %>
                Apresentado em <%= bill.submission_date.strftime("%d/%m/%Y") %>
              <% end %>
            </span>
          </div>
          <p class="mb-2 text-muted small"><%= bill.summary %></p>
          <div class="d-flex flex-wrap align-items-center gap-1">
            <% bill.keywords.to_s.split(",").map { |k| k.strip.delete_suffix(".") }.compact_blank.first(6).each do |keyword| %>
              <span class="badge badge-wrap text-bg-light border fw-normal"><%= keyword %></span>
            <% end %>
            <% if bill.url.present? %>
              <%= link_to bill.url, target: "_blank", rel: "noopener", class: "small text-gold text-decoration-none ms-auto" do %>
                Tramitação na Câmara <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%= render "shared/pagination", page: @tab_page, total_pages: @tab_total_pages,
          path_for: ->(p) { deputy_tab_path(@deputy, "bills", filter_params.merge(page: p)) } %>
  <% end %>
</div>
