<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
  <h2 class="h6 fw-bold text-navy text-uppercase tracking-wider mb-3">Eleições 2026</h2>

  <% if @candidate.nil? %>
    <div class="text-center py-4">
      <i class="fa-solid fa-check-to-slot fa-3x text-gold mb-3"></i>
      <p class="text-muted mb-0">Não encontramos candidatura registrada para este deputado em 2026.</p>
    </div>
  <% else %>
    <div class="row g-3">
      <% [
           ["Nome de urna", @candidate.ballot_name],
           ["Número", @candidate.number],
           ["Partido", (link_to(@candidate.party.label, party_path(@candidate.party), class: "text-reset") if @candidate.party)],
           ["Estado", @candidate.state_label],
           ["Reeleição", @candidate.reelection? ? "Sim" : "Não"],
           ["Situação da candidatura", @candidate.candidacy_status],
           ["Ocupação declarada", @candidate.occupation&.capitalize],
           ["Escolaridade", @candidate.education_level&.capitalize]
         ].select { |_, value| value.present? }.each do |label, value| %>
        <div class="col-sm-6 col-lg-3">
          <div class="p-3 bg-light rounded-3 h-100">
            <span class="d-block text-muted small fw-bold text-uppercase mb-1 tracking-wider"><%= label %></span>
            <span class="text-navy fw-medium"><%= value %></span>
          </div>
        </div>
      <% end %>
    </div>

    <% if @candidate.party_id != @deputy.party_id && @candidate.party %>
      <div class="alert alert-warning small mt-3 mb-0">
        <i class="fa-solid fa-right-left me-1"></i>
        Concorre por um partido diferente do atual
        (<%= @deputy.party ? link_to(@deputy.party.label, party_path(@deputy.party), class: "alert-link") : "sem partido" %> →
        <%= link_to @candidate.party.label, party_path(@candidate.party), class: "alert-link" %>).
      </div>
    <% end %>

    <div class="mt-3">
      <%= link_to candidate_path(@candidate), class: "btn btn-light border rounded-pill px-4 text-navy fw-medium", data: { turbo_frame: "_top" } do %>
        Ver ficha de candidatura <i class="fa-solid fa-arrow-right ms-1"></i>
      <% end %>
    </div>
  <% end %>
</div>
