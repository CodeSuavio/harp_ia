<% filter_params = { vote: @vote_filter, theme: @theme&.slug }.compact %>
<% against = DeputiesController::AGAINST_PARTY %>

<!-- Resumo -->
<div class="row g-3 mb-4">
  <div class="col-md-6 col-xl-3">
    <div class="p-4 bg-white rounded-4 shadow-sm border-start border-4 border-gold h-100">
      <span class="d-block text-muted small fw-bold text-uppercase mb-2 tracking-wider">
        Participação
        <%= info_tip("Votações em que votou, entre as registradas no período do seu primeiro ao último voto. Assim suplentes e licenciados não são contados como ausentes antes de assumir ou depois de sair.") %>
      </span>
      <span class="h3 fw-bold text-navy"><%= percent(@participation[:pct]) %></span>
      <div class="small text-muted">
        votou em <%= @participation[:voted] %> de <%= @participation[:total] %> votações
        <% if @participation[:from] %>
          entre <%= @participation[:from].strftime("%d/%m/%Y") %> e <%= @participation[:to].strftime("%d/%m/%Y") %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-xl-3">
    <div class="p-4 bg-white rounded-4 shadow-sm h-100">
      <span class="d-block text-muted small fw-bold text-uppercase mb-2 tracking-wider">
        Alinhamento com o <%= @deputy.party&.label || "partido" %>
        <%= info_tip("Votos Sim/Não iguais aos da maioria do partido, sem contar o próprio deputado. Abstenções, obstruções e votações em que o partido empatou não entram.") %>
      </span>
      <span class="h3 fw-bold text-navy"><%= percent(@alignment[:pct]) %></span>
      <div class="small text-muted">
        acompanhou a maioria do partido em <%= @alignment[:aligned] %> de <%= @alignment[:total] %> votos Sim/Não
      </div>
    </div>
  </div>
  <div class="col-md-6 col-xl-3">
    <div class="p-4 bg-white rounded-4 shadow-sm h-100">
      <span class="d-block text-muted small fw-bold text-uppercase mb-2 tracking-wider">Votos contra o partido</span>
      <span class="h3 fw-bold text-navy"><%= @alignment[:against] %></span>
      <div class="small">
        <% if @alignment[:against].positive? %>
          <%= link_to (@vote_filter == against ? "Ver todos os votos" : "Ver essas votações"),
                deputy_tab_path(@deputy, "votes", filter_params.merge(vote: (against unless @vote_filter == against))),
                class: "text-gold fw-bold text-decoration-none" %>
        <% else %>
          <span class="text-muted">sempre acompanhou o partido</span>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-xl-3">
    <div class="p-4 bg-white rounded-4 shadow-sm h-100">
      <span class="d-block text-muted small fw-bold text-uppercase mb-2 tracking-wider">Distribuição dos votos</span>
      <% total_votes = [@vote_counts.values.sum, 1].max %>
      <% distribution = @vote_counts.sort_by { |_, n| -n } %>
      <div class="progress vote-distribution mb-2" style="height: 10px;" role="img"
           aria-label="Distribuição dos votos: <%= distribution.map { |vote, n| "#{vote} #{n}" }.join(', ') %>">
        <% distribution.each do |vote, n| %>
          <div class="progress-bar <%= vote_badge_class(vote) %>" style="width: <%= (n * 100.0 / total_votes).round(1) %>%" title="<%= vote %>: <%= n %>"></div>
        <% end %>
      </div>
      <div class="d-flex flex-wrap gap-1">
        <%= link_to "Todos", deputy_tab_path(@deputy, "votes", filter_params.except(:vote)),
              class: "badge rounded-pill text-decoration-none #{@vote_filter ? 'text-bg-light border' : 'text-bg-dark'}" %>
        <% distribution.each do |vote, n| %>
          <%= link_to "#{vote} (#{n})", deputy_tab_path(@deputy, "votes", filter_params.merge(vote: vote)),
                class: "badge rounded-pill text-decoration-none #{vote_badge_class(vote)} #{'opacity-50' if @vote_filter && @vote_filter != vote}",
                title: vote_explanation(vote), data: ({ controller: "tooltip" } if vote_explanation(vote)) %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if @themes.any? %>
  <!-- Votações por tema -->
  <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <h2 class="h6 fw-bold text-navy text-uppercase tracking-wider mb-2">
      Votações por tema
      <%= info_tip("Tema do projeto de lei votado, classificado automaticamente por palavras-chave. Votações sem projeto vinculado ficam de fora.") %>
    </h2>
    <div class="d-flex flex-wrap gap-1">
      <% @themes.sort_by { |_, count| -count }.each do |theme, count| %>
        <%= link_to "#{theme.name} (#{count})",
              deputy_tab_path(@deputy, "votes", filter_params.merge(theme: (theme.slug unless @theme == theme))),
              class: "badge rounded-pill text-decoration-none fw-medium #{@theme == theme ? 'text-bg-dark' : 'text-bg-light border text-navy'}",
              aria: { pressed: @theme == theme } %>
      <% end %>
    </div>
  </div>
<% end %>

<!-- Histórico -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h2 class="h6 fw-bold text-navy text-uppercase tracking-wider mb-0 me-2">Histórico de votações</h2>
    <span class="small text-muted"><%= @tab_total %> <%= "voto".pluralize(@tab_total) %></span>
    <% if @vote_filter %>
      <%= link_to "#{@vote_filter == against ? 'Contra o partido' : @vote_filter} ×", deputy_tab_path(@deputy, "votes", filter_params.except(:vote)),
            class: "badge rounded-pill text-bg-light border text-decoration-none" %>
    <% end %>
    <% if @theme %>
      <%= link_to "#{@theme.name} ×", deputy_tab_path(@deputy, "votes", filter_params.except(:theme)),
            class: "badge rounded-pill text-bg-light border text-decoration-none" %>
    <% end %>
  </div>

  <% if @votes.empty? %>
    <p class="text-muted text-center py-4 mb-0">Nenhum voto registrado.</p>
  <% else %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 small">
        <thead class="table-light">
          <tr>
            <th class="ps-3">Data</th>
            <th>Votação</th>
            <th class="text-center">Voto</th>
            <th class="text-center">Maioria do partido</th>
            <th class="text-center pe-3">Resultado</th>
          </tr>
        </thead>
        <tbody>
          <% @votes.each do |vote| %>
            <% poll = vote.poll %>
            <% majority = @majorities[poll.id] %>
            <tr>
              <td class="ps-3 text-muted text-nowrap"><%= poll.date&.strftime("%d/%m/%Y") %></td>
              <td>
                <%= link_to poll_path(poll), class: "text-navy text-decoration-none", data: { turbo_frame: "_top" } do %>
                  <%= poll.description.to_s.truncate(110) %>
                <% end %>
                <div class="text-muted">
                  <%= poll.label_comission %>
                  <% if poll.bill %> · Proposição <%= poll.bill.bill_number %>/<%= poll.bill.year %><% end %>
                </div>
              </td>
              <td class="text-center">
                <span class="badge rounded-pill <%= vote_badge_class(vote.vote) %>" title="<%= vote_explanation(vote.vote) %>"><%= vote.vote %></span>
              </td>
              <td class="text-center">
                <% if majority %>
                  <span class="badge rounded-pill <%= vote_badge_class(majority) %>"><%= majority %></span>
                  <% if Vote::DECISIVE.include?(vote.vote) %>
                    <% with_party = majority == vote.vote %>
                    <i class="fa-solid <%= with_party ? 'fa-check text-success' : 'fa-xmark text-danger' %> ms-1"
                       title="<%= with_party ? 'Votou com o partido' : 'Votou contra o partido' %>" aria-hidden="true"></i>
                    <span class="visually-hidden"><%= with_party ? "Votou com o partido" : "Votou contra o partido" %></span>
                  <% end %>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td class="text-center pe-3">
                <% unless poll.approval.nil? %>
                  <span class="<%= poll.approval ? 'text-success' : 'text-danger' %> fw-medium"><%= poll.approval ? "Aprovado" : "Rejeitado" %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination", page: @tab_page, total_pages: @tab_total_pages,
          path_for: ->(p) { deputy_tab_path(@deputy, "votes", filter_params.merge(page: p)) } %>
  <% end %>
</div>
