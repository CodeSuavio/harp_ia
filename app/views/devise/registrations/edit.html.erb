<div class="hero-section d-flex align-items-center justify-content-center py-5" style="min-height: 100vh;">
  <!-- Brilho dourado ao fundo -->
  <div class="hero-glow"></div>

  <div class="container position-relative z-1">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-5">

        <!-- Cartão de edição de perfil -->
        <div class="card inspiration-card border-0 shadow-lg p-4 p-md-5">

          <div class="text-center mb-4">
            <div class="mb-3">
              <i class="fa-solid fa-user-gear fa-2x text-gold"></i>
            </div>
            <h2 class="fw-bolder text-navy mb-2">Editar Perfil</h2>
            <p class="text-muted small">Atualize as suas credenciais de acesso.</p>
          </div>

          <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
            <%= f.error_notification %>

            <div class="form-inputs">
              <div class="mb-3">
                <%= f.input :email,
                            required: true,
                            autofocus: true,
                            input_html: { class: "bg-light border-0 py-2 rounded-3" } %>
              </div>

              <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                <div class="alert alert-warning small py-2 mb-3 border-0 rounded-3">
                  Aguardando confirmação para: <strong><%= resource.unconfirmed_email %></strong>
                </div>
              <% end %>

              <div class="mb-3">
                <%= f.input :password,
                            label: "Nova Senha",
                            hint: "Deixe em branco se não quiser alterar",
                            required: false,
                            input_html: { autocomplete: "new-password", class: "bg-light border-0 py-2 rounded-3" } %>
              </div>

              <div class="mb-3">
                <%= f.input :password_confirmation,
                            label: "Confirme a Nova Senha",
                            required: false,
                            input_html: { autocomplete: "new-password", class: "bg-light border-0 py-2 rounded-3" } %>
              </div>

              <div class="mb-4 mt-4 pt-3 border-top">
                <%= f.input :current_password,
                            label: "Senha Atual",
                            hint: "Precisamos da sua senha atual para confirmar as mudanças",
                            required: true,
                            input_html: { autocomplete: "current-password", class: "bg-light border-0 py-2 rounded-3 border border-warning" } %>
              </div>
            </div>

            <div class="form-actions d-grid mt-2">
              <%= f.button :submit, "ATUALIZAR DADOS", class: "btn btn-auth rounded-pill py-3 fw-bold text-uppercase shadow-sm" %>
            </div>
          <% end %>

          <!-- Zona de Perigo (Cancelar Conta) -->
          <div class="mt-5 pt-4 border-top text-center">
            <h3 class="h6 fw-bold text-navy mb-2">Encerrar Conta</h3>
            <p class="text-muted small mb-3">Insatisfeito com a plataforma? Esta ação é irreversível.</p>

            <%= button_to "Cancelar minha conta", registration_path(resource_name), data: { confirm: "Tem certeza que deseja cancelar sua conta?", turbo_confirm: "Tem certeza que deseja cancelar sua conta?" }, method: :delete, class: "btn btn-outline-danger rounded-pill px-4 py-2 small fw-medium" %>
          </div>

          <div class="mt-4 text-center">
            <%= link_to "← Voltar", :back, class: "text-muted small text-decoration-none" %>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
