<div class="hero-section d-flex align-items-center justify-content-center" style="min-height: 100vh;">
  <!-- O brilho dourado ao fundo para manter a identidade visual -->
  <div class="hero-glow"></div>

  <div class="container position-relative z-1">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-5">

        <!-- Cartão branco e elegante com bordas arredondadas e sombra -->
        <div class="card inspiration-card border-0 shadow-lg p-4 p-md-5">

          <div class="text-center mb-4">
            <div class="mb-3">
              <i class="fa-solid fa-user-plus fa-2x text-gold"></i>
            </div>
            <h2 class="fw-bolder text-navy mb-2">Crie sua Conta</h2>
            <p class="text-muted small">Junte-se ao Harpia e tenha a transparência eleitoral nas suas mãos.</p>
          </div>

          <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= f.error_notification %>

            <div class="form-inputs">
              <!-- Colocando Nome e Sobrenome lado a lado para economizar espaço vertical -->
              <div class="row">
                <div class="col-6 mb-3">
                  <%= f.input :first_name,
                              required: true,
                              autofocus: true,
                              label: "Nome",
                              input_html: { autocomplete: "given-name", class: "bg-light border-0 py-2 rounded-3" } %>
                </div>
                <div class="col-6 mb-3">
                  <%= f.input :last_name,
                              required: true,
                              label: "Sobrenome",
                              input_html: { autocomplete: "family-name", class: "bg-light border-0 py-2 rounded-3" } %>
                </div>
              </div>

              <div class="mb-3">
                <%= f.input :email,
                            required: true,
                            input_html: { autocomplete: "email", class: "bg-light border-0 py-2 rounded-3" }%>
              </div>

              <div class="mb-3">
                <%= f.input :password,
                            required: true,
                            label: "Senha",
                            hint: ("Mínimo de #{@minimum_password_length} caracteres" if @minimum_password_length),
                            input_html: { autocomplete: "new-password", class: "bg-light border-0 py-2 rounded-3" } %>
              </div>

              <div class="mb-4">
                <%= f.input :password_confirmation,
                            required: true,
                            label: "Confirme a Senha",
                            input_html: { autocomplete: "new-password", class: "bg-light border-0 py-2 rounded-3" } %>
              </div>
            </div>

            <div class="form-actions d-grid mt-2">
              <%= f.button :submit, "CADASTRAR", class: "btn btn-auth rounded-pill py-3 fw-bold text-uppercase shadow-sm" %>
            </div>
          <% end %>

          <!-- Links auxiliares (Login, Esqueceu a senha, etc) -->
          <div class="mt-4 text-center mt-3 pt-3 border-top">
            <%= render "devise/shared/links" %>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
