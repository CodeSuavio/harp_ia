<div class="hero-section d-flex align-items-center justify-content-center py-5" style="min-height: 100vh;">
  <!-- Brilho dourado ao fundo imitando a identidade visual da Harpia -->
  <div class="hero-glow"></div>

  <div class="container position-relative z-1">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-5">

        <!-- Cartão branco e elegante com sombras suaves -->
        <div class="card inspiration-card border-0 shadow-lg p-4 p-md-5">

          <div class="text-center mb-4">
            <div class="mb-3">
              <i class="fa-solid fa-right-to-bracket fa-2x text-gold"></i>
            </div>
            <h2 class="fw-bolder text-navy mb-2">Acesso ao Sistema</h2>
            <p class="text-muted small">Bem-vindo de volta ao painel de inteligência da Harpia.</p>
          </div>

          <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="form-inputs">

              <div class="mb-3">
                <%= f.input :email,
                            required: false,
                            autofocus: true,
                            label: "E-mail",
                            input_html: { autocomplete: "email", class: "bg-light border-0 py-2 rounded-3" } %>
              </div>

              <div class="mb-3">
                <%= f.input :password,
                            required: false,
                            label: "Senha",
                            input_html: { autocomplete: "current-password", class: "bg-light border-0 py-2 rounded-3" } %>
              </div>

              <% if devise_mapping.rememberable? %>
                <div class="mb-4 form-check form-switch px-0 d-flex align-items-center">
                  <%= f.input :remember_me,
                              as: :boolean,
                              label: "Lembrar-me neste dispositivo",
                              wrapper_html: { class: "mb-0" },
                              input_html: { class: "form-check-input shadow-none ms-0 me-2" },
                              label_html: { class: "small text-muted mb-0 pt-1" } %>
                </div>
              <% end %>
            </div>

            <div class="form-actions d-grid mt-2">
              <%= f.button :submit, "ENTRAR", class: "btn btn-auth rounded-pill py-3 fw-bold text-uppercase shadow-sm" %>
            </div>
          <% end %>

          <!-- Links auxiliares (Criar conta, Esqueceu a senha, etc) -->
          <div class="mt-4 text-center pt-3 border-top">
            <%= render "devise/shared/links" %>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
