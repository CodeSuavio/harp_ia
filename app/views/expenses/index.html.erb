<div class="container py-5">
  <!-- Botão Voltar -->
  <div class="mb-4">
    <%= link_to deputy_path(@deputy), class: "text-decoration-none text-muted fw-medium transition" do %>
      <i class="fa-solid fa-arrow-left me-2"></i> Voltar ao Perfil do Deputado
    <% end %>
  </div>

  <!-- Cabeçalho da Página -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
      <h1 class="h3 fw-bold text-navy mb-1">
        <i class="fa-solid fa-receipt text-gold me-2"></i> Gastos do Deputado
      </h1>
      <p class="text-muted mb-0">Monitoramento detalhado de despesas e prestação de contas</p>
    </div>
  </div>

  <!-- Cartão Principal de Dados -->
  <div class="card inspiration-card shadow-sm border-0 rounded-4 p-4 p-lg-5 bg-white">

    <!-- Bloco de Resumo (Opcional - Exemplo de Totalizador) -->
    <div class="row mb-5">
      <div class="col-md-5 col-lg-4">
        <div class="p-4 bg-light rounded-4 border-start border-4 border-gold h-100 shadow-sm">
          <span class="d-block text-muted small fw-bold text-uppercase mb-2 tracking-wider">
            <i class="fa-solid fa-wallet text-gold me-1"></i> Total Gasto Declarado
          </span>
          <span class="display-6 fw-bold text-navy">R$ 0,00</span>
        </div>
      </div>
    </div>

    <!-- Tabela de Despesas -->
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="text-navy text-uppercase small tracking-wider border-0 rounded-start-3 py-3 ps-3">Data</th>
            <th class="text-navy text-uppercase small tracking-wider border-0 py-3">Tipo de Despesa</th>
            <th class="text-navy text-uppercase small tracking-wider border-0 py-3">Fornecedor</th>
            <th class="text-navy text-uppercase small tracking-wider border-0 rounded-end-3 py-3 pe-3 text-end">Valor (R$)</th>
          </tr>
        </thead>
        <tbody>

          <!-- Exemplo de "Empty State" (Enquanto não tiver o loop dos dados reais) -->
          <tr>
            <td colspan="4" class="text-center py-5 border-0">
              <div class="empty-state bg-transparent border-0 py-4">
                <div class="mb-3">
                  <i class="fa-solid fa-ghost fa-3x text-pastel-yellow"></i>
                </div>
                <h4 class="h5 text-navy fw-bold mb-1">Nenhum gasto registado</h4>
                <p class="text-muted small mb-0">Ainda não existem despesas disponíveis para visualização.</p>
              </div>
            </td>
          </tr>

          <!-- Aqui entrará o seu loop de dados. Exemplo de como a linha deve ficar:
          <%# @expenses.each do |expense| %>
            <tr>
              <td class="ps-3 fw-medium text-muted"><%#= expense.date.strftime("%d/%m/%Y") %></td>
              <td class="fw-medium text-navy"><%#= expense.type %></td>
              <td class="text-muted"><%#= expense.supplier %></td>
              <td class="pe-3 text-end fw-bold text-navy"><%#= number_to_currency(expense.value) %></td>
            </tr>
          <%# end %>
          -->

        </tbody>
      </table>
    </div>

  </div>
</div>
