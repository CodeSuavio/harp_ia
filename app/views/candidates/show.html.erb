<div class="container my-4">
  <%= link_to "← Candidatos", candidates_path %>

  <div class="row mt-3">
    <div class="col-md-4">
      <% if @candidate.photo_file.present? %>
        <%= image_tag @candidate.photo_file, class: "img-fluid rounded", alt: @candidate.ballot_name %>
      <% end %>
    </div>

    <div class="col-md-8">
      <h1><%= @candidate.ballot_name %></h1>
      <p class="text-muted"><%= @candidate.name %></p>

      <dl class="row">
        <dt class="col-sm-4">Número</dt>
        <dd class="col-sm-8"><%= @candidate.number %></dd>

        <dt class="col-sm-4">Partido</dt>
        <dd class="col-sm-8">
          <%= link_to @candidate.party.label, party_path(@candidate.party) if @candidate.party %>
        </dd>

        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8"><%= @candidate.state_label %></dd>

        <dt class="col-sm-4">Situação da candidatura</dt>
        <dd class="col-sm-8"><%= @candidate.candidacy_status %></dd>

        <dt class="col-sm-4">Concorre à reeleição</dt>
        <dd class="col-sm-8"><%= @candidate.running_for_reelection ? "Sim" : "Não" %></dd>

        <dt class="col-sm-4">Escolaridade</dt>
        <dd class="col-sm-8"><%= @candidate.education_level %></dd>

        <dt class="col-sm-4">Ocupação</dt>
        <dd class="col-sm-8"><%= @candidate.occupation %></dd>
      </dl>
    </div>
  </div>
</div>
