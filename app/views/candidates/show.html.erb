<% deputy = @candidate.current_deputy %>
<% status = @candidate.candidacy_status.to_s %>

<div class="container my-4">
  <%= link_to "← Candidatos", candidates_path %>

  <div class="row mt-3">
    <div class="col-md-4">
      <% if @candidate.photo.attached? %>
        <%= cl_image_tag @candidate.photo.key, class: "img-fluid rounded", alt: @candidate.ballot_name %>
      <% else %>
        <div class="candidate-photo-large rounded d-flex align-items-center justify-content-center">
          <span class="text-muted"><%= @candidate.ballot_name.to_s.first %></span>
        </div>
      <% end %>
    </div>

    <div class="col-md-8">
      <h1><%= @candidate.ballot_name %></h1>
      <p class="text-muted"><%= @candidate.name %></p>

      <dl class="row">
        <dt class="col-sm-4">Número</dt>
        <dd class="col-sm-8"><%= @candidate.number %></dd>

        <dt class="col-sm-4">Partido</dt>
        <dd class="col-sm-8">
          <%= link_to @candidate.party.label, party_path(@candidate.party) if @candidate.party %>
        </dd>

        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8"><%= @candidate.state_label %></dd>

        <% if deputy %>
          <dt class="col-sm-4">Deputado em exercício</dt>
          <dd class="col-sm-8"><%= link_to deputy.name, deputy_path(deputy) %></dd>
        <% end %>

        <% if status.present? && status != "#NE" %>
          <dt class="col-sm-4">Situação da candidatura</dt>
          <dd class="col-sm-8"><%= status %></dd>
        <% end %>

        <dt class="col-sm-4">Concorre à reeleição</dt>
        <dd class="col-sm-8"><%= @candidate.reelection? ? "Sim" : "Não" %></dd>

        <% if @candidate.gender.present? %>
          <dt class="col-sm-4">Gênero</dt>
          <dd class="col-sm-8"><%= @candidate.gender.capitalize %></dd>
        <% end %>

        <% if @candidate.race_color.present? %>
          <dt class="col-sm-4">Cor ou raça</dt>
          <dd class="col-sm-8"><%= @candidate.race_color.capitalize %></dd>
        <% end %>

        <dt class="col-sm-4">Escolaridade</dt>
        <dd class="col-sm-8"><%= @candidate.education_level %></dd>

        <dt class="col-sm-4">Ocupação</dt>
        <dd class="col-sm-8"><%= @candidate.occupation %></dd>
      </dl>

      <div class="d-flex flex-wrap gap-2">
        <%= render "painel/ask_harpia", question: harpia_question(@candidate, @overview) %>
        <% if deputy %>
          <%= link_to deputy_path(deputy), class: "btn btn-outline-secondary rounded-pill px-4" do %>
            <i class="fa-solid fa-chart-line me-2"></i>Painel do deputado
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @overview %>
    <%= render "deputies/spending", overview: @overview %>
    <%= render "deputies/votes", overview: @overview %>
  <% end %>
</div>
