<div class="container my-4">
  <h1 class="mb-4">Candidatos</h1>

  <% if @candidates.empty? %>
    <p class="text-muted">Nenhum candidato cadastrado.</p>
  <% else %>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Nome de urna</th>
            <th>Número</th>
            <th>Partido</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <% @candidates.each do |candidate| %>
            <tr>
              <td><%= link_to candidate.ballot_name, candidate_path(candidate) %></td>
              <td><%= candidate.number %></td>
              <td><%= candidate.party&.label %></td>
              <td><%= candidate.state_label %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
