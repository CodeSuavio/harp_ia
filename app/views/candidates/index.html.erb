<%= render "painel/hero", title: "Candidatos", highlight: "2026",
      subtitle: "Quem concorre, por onde e, quando já tem mandato, como atuou." %>

<section class="container search-container pb-5">
  <%= turbo_frame_tag "candidates_list", data: { turbo_action: "advance" } do %>
    <%= form_with url: candidates_path, method: :get,
                  data: {
                    controller: "filter-form",
                    action: "input->filter-form#submit change->filter-form#submit"
                  },
                  class: "search-card shadow-lg bg-white rounded-4 p-3 mb-4" do %>
      <div class="row g-2 align-items-center">
        <div class="col-lg-4 panel-filter-col">
          <div class="input-group border-0">
            <span class="input-group-text bg-transparent border-0 text-muted">
              <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <%= text_field_tag :q, params[:q],
                  id: "candidate-search",
                  placeholder: "Nome do candidato ou sigla do partido...",
                  class: "form-control border-0 shadow-none bg-transparent fw-medium",
                  data: { turbo_permanent: true } %>
          </div>
        </div>

        <div class="col-6 col-lg panel-filter-col">
          <%= select_tag :state,
                options_for_select(
                  [["Todos os estados", ""]] + @states.map { |s| ["#{s} (#{@state_counts[s].to_i})", s] },
                  params[:state]
                ),
                class: "form-select border-0 shadow-none bg-transparent text-muted fw-medium" %>
        </div>

        <div class="col-6 col-lg panel-filter-col">
          <% ordered_parties = @parties.sort_by { |p| [-@party_counts[p.id].to_i, p.label] } %>
          <%= select_tag :party,
                options_for_select(
                  [["Todos os partidos", ""]] + ordered_parties.map { |p| ["#{p.label} (#{@party_counts[p.id].to_i})", p.id] },
                  params[:party]
                ),
                class: "form-select border-0 shadow-none bg-transparent text-muted fw-medium" %>
        </div>

        <div class="col-6 col-lg panel-filter-col">
          <%= select_tag :gender,
                options_for_select(
                  [["Todos os gêneros", ""],
                   ["Feminino (#{@gender_counts['FEMININO'].to_i})", "FEMININO"],
                   ["Masculino (#{@gender_counts['MASCULINO'].to_i})", "MASCULINO"]],
                  params[:gender]
                ),
                class: "form-select border-0 shadow-none bg-transparent text-muted fw-medium" %>
        </div>

        <div class="col-6 col-lg panel-filter-col">
          <%= select_tag :sort,
                options_for_select(
                  [["Ordenar por nome", "name"], ["Ordenar por estado", "state"], ["Ordenar por número", "number"]],
                  params[:sort]
                ),
                class: "form-select border-0 shadow-none bg-transparent text-muted fw-medium" %>
        </div>
      </div>
    <% end %>

    <%= render "list" %>
  <% end %>
</section>
