<p class="text-muted small mb-3">
  <%= @total %> <%= "candidato".pluralize(@total) %>
</p>

<% if @candidates.empty? %>
  <p class="text-muted text-center py-5">
    Nenhum candidato foi encontrado na sua pesquisa.
  </p>
<% else %>
  <div class="row g-4">
    <% @candidates.each do |candidate| %>
      <div class="col-sm-6 col-lg-3">
        <%= link_to candidate_path(candidate), class: "text-decoration-none text-reset" do %>
          <div class="card candidate-card h-100 text-center border-0 shadow-sm">
            <div class="card-body">
              <div class="candidate-photo candidate-photo-placeholder rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center">
                <i class="fa-solid fa-user text-muted"></i>
              </div>

              <h3 class="h6 mb-1"><%= candidate.ballot_name.presence || candidate.name %></h3>
              <p class="text-brand small fw-bold text-uppercase mb-2">
                <%= candidate.party&.label %> · <%= candidate.state_label %>
              </p>

              <div class="d-flex justify-content-around border-top pt-2 mt-2 small text-muted">
                <span>#<%= candidate.number %></span>
                <span><%= candidate.candidacy_status.presence || "Não informado" %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <nav class="d-flex justify-content-center align-items-center gap-3 mt-5">
      <% if @page > 1 %>
        <%= link_to "Anterior", candidates_path(request.query_parameters.merge(page: @page - 1)), class: "btn btn-outline-secondary btn-sm" %>
      <% end %>

      <span class="small text-muted">Página <%= @page %> de <%= @total_pages %></span>

      <% if @page < @total_pages %>
        <%= link_to "Próxima", candidates_path(request.query_parameters.merge(page: @page + 1)), class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
    </nav>
  <% end %>
<% end %>
