<% content_for :title, "Alertas de gastos · Harpia" %>

<%= render "painel/hero", title: "Alertas", highlight: "de gastos",
      subtitle: "Deputados com mais gastos fora do padrão na cota parlamentar, pela gravidade dos alertas." %>

<% filter_params = { year: @year, state: @state, party: @party&.id, severity: (@severity unless @severity == "low"),
                    order: (@order unless @order == "score") }.compact %>
<%# Gravidade: cor, ícone e nome, da mais grave para a mais leve %>
<% severity_badges = { high: ["text-bg-danger", "fa-circle-exclamation", "alta"],
                       medium: ["text-bg-warning", "fa-triangle-exclamation", "média"],
                       low: ["text-bg-light border", "fa-circle-info", "baixa"] } %>

<section class="container search-container pb-5">
  <!-- Aviso fixo -->
  <div class="bg-white border rounded-4 small mb-4 p-3">
    <div class="d-flex gap-2 align-items-start">
      <i class="fa-solid fa-circle-info text-gold mt-1" aria-hidden="true"></i>
      <div>
        <p class="mb-1 text-navy fw-semibold">Alerta não é prova de irregularidade.</p>
        <p class="mb-0">
          Os alertas apontam gastos que fogem do padrão (do próprio deputado, da Câmara ou do cadastro do fornecedor na Receita Federal)
          e merecem um olhar mais atento. Pode haver explicação legítima para cada um. Confira as notas no perfil do deputado e na Câmara.
          Fonte: cota parlamentar (CEAP) de <%= @year %>, dados abertos da Câmara dos Deputados e cadastro de CNPJ da Receita Federal (BrasilAPI).
        </p>
      </div>
    </div>
  </div>

  <!-- Filtros -->
  <%= form_with url: expense_alerts_path, method: :get,
        data: { controller: "filter-form", action: "change->filter-form#submit" },
        class: "card search-card shadow-sm bg-white rounded-4 p-3 border-0 mb-4" do %>
    <div class="row g-2 align-items-center">
      <div class="col-6 col-lg">
        <%= label_tag :year, "Ano", class: "form-label small text-muted mb-1" %>
        <%= select_tag :year, options_for_select(@years, @year), class: "form-select form-select-sm" %>
      </div>
      <div class="col-6 col-lg">
        <%= label_tag :state, "Estado", class: "form-label small text-muted mb-1" %>
        <%= select_tag :state, options_for_select([["Todos os estados", ""]] + @states, @state), class: "form-select form-select-sm" %>
      </div>
      <div class="col-6 col-lg">
        <%= label_tag :party, "Partido", class: "form-label small text-muted mb-1" %>
        <%= select_tag :party, options_for_select([["Todos os partidos", ""]] + @parties.map { |p| [p.label, p.id] }, @party&.id),
              class: "form-select form-select-sm" %>
      </div>
      <div class="col-6 col-lg">
        <%= label_tag :severity, "Gravidade mínima", class: "form-label small text-muted mb-1" %>
        <%= select_tag :severity, options_for_select(ExpenseAlertsController::SEVERITY_LABELS.invert, @severity),
              class: "form-select form-select-sm" %>
      </div>
      <div class="col-12 col-lg">
        <%= label_tag :order, "Ordenar por", class: "form-label small text-muted mb-1" %>
        <%= select_tag :order, options_for_select(ExpenseAlertsController::ORDERS.invert, @order),
              class: "form-select form-select-sm" %>
      </div>
    </div>
    <noscript><button type="submit" class="btn btn-sm btn-dark mt-2">Filtrar</button></noscript>
  <% end %>

  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <span class="text-muted small me-2"><%= @total %> <%= "deputado".pluralize(@total) %> com alertas</span>
    <span class="small text-muted">
      <% if @order == "share" %>
        Ordem: parte do gasto do ano que está em notas com alerta, depois a pontuação.
        <%= info_tip("Cada nota conta uma vez, mesmo que esteja em mais de um alerta. Alertas sem notas (pico mensal, salto por tipo) não entram nessa conta. Útil para comparar deputados com volumes de gasto diferentes.") %>
      <% else %>
        Ordem: pontuação (alta = <%= ExpenseAlert::WEIGHTS["high"] %>, média = <%= ExpenseAlert::WEIGHTS["medium"] %>,
        baixa = <%= ExpenseAlert::WEIGHTS["low"] %> pontos por alerta), depois o valor sinalizado.
        <%= info_tip("Quem tem mais notas tem mais chance de cair em alguma regra. Para comparar volumes diferentes, ordene pela parte do gasto em notas com alerta. O valor sinalizado soma o valor de cada alerta, e um mesmo gasto pode entrar em mais de um.") %>
      <% end %>
    </span>
    <% if @computed_at %>
      <span class="small text-muted ms-md-auto">Alertas calculados em <%= @computed_at.strftime("%d/%m/%Y") %></span>
    <% end %>
  </div>

  <% if @computed_at.nil? && @years.include?(@year) %>
    <p class="text-muted text-center py-5">
      Os alertas de <%= @year %> ainda não foram calculados. Eles são atualizados todos os dias; volte mais tarde.
    </p>
  <% elsif @page_rows.empty? %>
    <p class="text-muted text-center py-5">Nenhum deputado com alertas nesse recorte.</p>
  <% else %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
      <% @page_rows.each_with_index do |row, index| %>
        <% deputy = row[:deputy] %>
        <% position = (@page - 1) * ExpenseAlertsController::PER_PAGE + index + 1 %>
        <% kinds = @kinds[deputy.id].to_a %>
        <% total = @expenses.dig(deputy.id, :total) %>
        <div class="col">
          <article class="card alert-rank-card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-4 d-flex flex-column">
              <!-- Quem é -->
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="position-relative flex-shrink-0">
                  <% if deputy.photo.attached? %>
                    <%= cl_image_tag deputy.photo.key, class: "alert-rank-photo rounded-circle", alt: "", loading: "lazy" %>
                  <% elsif deputy.photo_url.to_s.start_with?("http") %>
                    <%= image_tag deputy.photo_url, class: "alert-rank-photo rounded-circle", alt: "", loading: "lazy" %>
                  <% else %>
                    <div class="alert-rank-photo candidate-photo-placeholder rounded-circle d-flex align-items-center justify-content-center">
                      <i class="fa-solid fa-user text-muted" aria-hidden="true"></i>
                    </div>
                  <% end %>
                  <span class="alert-rank-position" title="Posição no ranking"><span class="visually-hidden">Posição </span><%= position %>º</span>
                </div>
                <div class="min-w-0">
                  <h2 class="h6 fw-bold text-navy mb-0 text-truncate">
                    <%= link_to deputy.name, deputy_path(deputy, tab: "expenses", year: @year, alerts: "1"),
                          class: "text-reset text-decoration-none stretched-link" %>
                  </h2>
                  <span class="small text-muted"><%= [deputy.party&.label, deputy.state_label].compact.join(" · ") %></span>
                </div>
              </div>

              <!-- Gravidade -->
              <div class="d-flex flex-wrap align-items-center gap-1 mb-3">
                <span class="small text-muted me-1"><%= pluralize(row[:count], "alerta", plural: "alertas") %>:</span>
                <% severity_badges.each do |severity, (css, icon, label)| %>
                  <span class="badge rounded-pill <%= css %> fw-medium<%= " is-zero" if row[severity].to_i.zero? %>" title="Alertas de gravidade <%= label %>">
                    <i class="fa-solid <%= icon %> me-1" aria-hidden="true"></i><%= row[severity] %> <%= row[severity] == 1 ? label : "#{label}s" %>
                  </span>
                <% end %>
              </div>

              <!-- Quanto dinheiro -->
              <div class="alert-rank-money rounded-3 p-3 mb-3">
                <div class="small text-muted">Em notas com alerta</div>
                <div class="h5 fw-bold text-navy mb-1"><%= brl(row[:flagged], precision: 0) %></div>
                <% if row[:share] %>
                  <div class="progress rounded-pill mb-1" style="height: 6px;" role="progressbar"
                       aria-label="Parte do gasto do ano em notas com alerta" aria-valuenow="<%= row[:share] %>" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar bg-gold" style="width: <%= [row[:share], 100].min %>%"></div>
                  </div>
                  <div class="small text-muted">
                    <strong class="text-navy"><%= row[:share].to_s.tr(".", ",") %>%</strong> dos <%= brl(total, precision: 0) %> gastos em <%= @year %>
                    · <%= pluralize(@note_counts[deputy.id].to_i, "nota", plural: "notas") %> no ano
                  </div>
                <% end %>
              </div>

              <!-- O que foi encontrado -->
              <% if kinds.any? %>
                <div class="small mb-3">
                  <div class="text-muted mb-1">O que foi encontrado</div>
                  <ul class="list-unstyled mb-0">
                    <% kinds.first(3).each do |kind, count| %>
                      <li class="d-flex justify-content-between gap-2">
                        <span class="text-navy"><%= expense_alert_kind_label(kind) %></span>
                        <span class="text-muted flex-shrink-0">×<%= count %></span>
                      </li>
                    <% end %>
                    <% if kinds.size > 3 %>
                      <li class="text-muted">e mais <%= pluralize(kinds.size - 3, "tipo", plural: "tipos") %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <!-- Próximo passo -->
              <div class="d-flex justify-content-between align-items-center gap-2 mt-auto pt-2 border-top small">
                <span class="text-muted" title="Alta = <%= ExpenseAlert::WEIGHTS['high'] %>, média = <%= ExpenseAlert::WEIGHTS['medium'] %>, baixa = <%= ExpenseAlert::WEIGHTS['low'] %> pontos por alerta">
                  <%= row[:score] %> pontos
                </span>
                <span class="text-gold fw-bold">Ver as notas com alerta<%= internal_link_icon %></span>
              </div>
            </div>
          </article>
        </div>
      <% end %>
    </div>

    <%= render "shared/pagination", page: @page, total_pages: @total_pages,
          path_for: ->(p) { expense_alerts_path(filter_params.merge(page: p)) } %>
  <% end %>
</section>
