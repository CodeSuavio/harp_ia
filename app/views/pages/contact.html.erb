<div class="contact-wrapper">

  <!-- ========================================== -->
  <!-- HERO SECTION: CONTATO -->
  <!-- ========================================== -->
  <section class="hero-section position-relative overflow-hidden d-flex align-items-center" style="padding: 6rem 0 8rem 0;">
    <div class="hero-glow"></div>
    <div class="container hero-content position-relative z-1 text-center">
      <h1 class="display-4 fw-bolder text-white mb-4 letter-spacing-tight">
        Fale com a <span class="text-gold">HARPIA</span>
      </h1>
      <p class="lead text-white-50 mx-auto" style="max-width: 700px; line-height: 1.8;">
        Tem dúvidas, sugestões ou quer colaborar com a nossa missão de trazer mais transparência para a política? Envie-nos uma mensagem!
      </p>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- ÁREA DE CONTATO E FORMULÁRIO -->
  <!-- ========================================== -->
  <section class="container position-relative" style="margin-top: -4rem; z-index: 10; margin-bottom: 5rem;">
    <div class="row g-4">

      <!-- Informações de Contato -->
      <div class="col-lg-5">
        <div class="card border-0 shadow-lg h-100 bg-white rounded-4 p-4 p-lg-5 inspiration-card">
          <h2 class="h4 fw-bold text-navy mb-4">Informações de Contato</h2>
          <p class="text-muted mb-5">
            Sinta-se à vontade para nos contatar através dos canais abaixo. A nossa equipa de entusiastas responderá o mais breve possível.
          </p>

          <!-- Placeholder: Email -->
          <div class="d-flex align-items-start mb-4">
            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3" style="width: 50px; height: 50px;">
              <i class="fa-solid fa-envelope fa-lg text-gold"></i>
            </div>
            <div>
              <h3 class="h6 fw-bold text-navy mb-1">E-mail</h3>
              <p class="text-muted small mb-0">contato@harpia.exemplo.com</p>
            </div>
          </div>

          <!-- Placeholder: Redes Sociais -->
          <div class="d-flex align-items-start mb-4">
            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3" style="width: 50px; height: 50px;">
              <i class="fa-brands fa-twitter fa-lg text-gold"></i>
            </div>
            <div>
              <h3 class="h6 fw-bold text-navy mb-1">Twitter / X</h3>
              <p class="text-muted small mb-0">@projeto_harpia</p>
            </div>
          </div>

          <!-- Placeholder: Localização -->
          <div class="d-flex align-items-start">
            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3" style="width: 50px; height: 50px;">
              <i class="fa-solid fa-location-dot fa-lg text-gold"></i>
            </div>
            <div>
              <h3 class="h6 fw-bold text-navy mb-1">Base de Operações</h3>
              <p class="text-muted small mb-0">Curitiba, PR - Brasil</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Formulário de Contato -->
      <div class="col-lg-7">
        <div class="card border-0 shadow-lg h-100 bg-white rounded-4 p-4 p-lg-5 inspiration-card">
          <h2 class="h4 fw-bold text-navy mb-4">Envie uma Mensagem</h2>

          <form action="#" method="post">
            <div class="row g-3">
              <!-- Nome Completo (com autocomplete de UX) -->
              <div class="col-md-6">
                <label for="nome" class="form-label text-navy fw-medium small">Nome Completo</label>
                <input type="text" class="form-control border-light shadow-sm bg-light" id="nome" placeholder="Seu nome" autocomplete="name" style="padding: 0.8rem;">
              </div>

              <!-- Email (com autocomplete de UX) -->
              <div class="col-md-6">
                <label for="email" class="form-label text-navy fw-medium small">E-mail</label>
                <input type="email" class="form-control border-light shadow-sm bg-light" id="email" placeholder="seu@email.com" autocomplete="email" style="padding: 0.8rem;">
              </div>

              <!-- Assunto -->
              <div class="col-12">
                <label for="assunto" class="form-label text-navy fw-medium small">Assunto</label>
                <input type="text" class="form-control border-light shadow-sm bg-light" id="assunto" placeholder="Como podemos ajudar?" style="padding: 0.8rem;">
              </div>

              <!-- Mensagem -->
              <div class="col-12">
                <label for="mensagem" class="form-label text-navy fw-medium small">Mensagem</label>
                <textarea class="form-control border-light shadow-sm bg-light" id="mensagem" rows="5" placeholder="Escreva a sua mensagem aqui..." style="padding: 0.8rem;"></textarea>
              </div>

              <!-- Botão Enviar -->
              <div class="col-12 mt-4 text-end">
                <button type="submit" class="btn rounded-pill px-5 py-3 fw-bold text-uppercase w-100 w-md-auto text-white border-0 shadow-sm transition" style="background-color: #F08A5D;">
                  Enviar Mensagem <i class="fa-solid fa-paper-plane ms-2"></i>
                </button>
              </div>
            </div>
          </form>

        </div>
      </div>

    </div>
  </section>

</div>
