<div data-controller="candidate-filter" class="home-wrapper">

<!-- Hero Section Criativo com Mira de Câmera -->
  <section class="hero-section position-relative overflow-hidden d-flex align-items-center">
    <div class="hero-glow"></div>
    <div class="container hero-content position-relative z-1">
      <div class="row align-items-center">

        <!-- Texto (Esquerda) -->
        <div class="col-lg-6 text-center text-lg-start mb-5 mb-lg-0">
          <h1 class="display-4 fw-bolder text-white mb-3 letter-spacing-tight">
            Foque nos seus <br><span class="text-gold">Candidatos</span>
          </h1>
          <p class="lead text-white-50 mb-0 mx-auto mx-lg-0" style="max-width: 450px;">
            Pesquise, compare e acompanhe os dados como um verdadeiro investigador. A política sob as suas lentes.
          </p>
        </div>

        <!-- Mira de Câmera com Mapa em Flash (Direita) -->
        <div class="col-lg-6 d-flex justify-content-center mt-5 mt-lg-0">
          <div class="camera-viewfinder">

            <!-- Bordas da Mira (Cantos) -->
            <div class="vf-corner vf-tl"></div>
            <div class="vf-corner vf-tr"></div>
            <div class="vf-corner vf-bl"></div>
            <div class="vf-corner vf-br"></div>

            <!-- Cruz de mira central (Crosshair) -->
            <div class="vf-crosshair-x"></div>
            <div class="vf-crosshair-y"></div>

            <!-- Efeito de Lente e Scanner -->
            <div class="lens-glare"></div>
            <div class="scanner-line"></div>

            <!-- Globo Holográfico (SVG Inline) -->
            <!-- Mapa Holográfico de Pontos (Capitais) com Fundo do País -->
            <div class="hologram-container">

              <!-- Silhueta Tática de Fundo do Brasil -->
              <div class="map-silhouette"></div>

              <!-- Norte -->
              <div class="capital-dot dot-rr"></div>
              <div class="capital-dot dot-ap"></div>
              <div class="capital-dot dot-am"></div>
              <div class="capital-dot dot-pa"></div>
              <div class="capital-dot dot-ac"></div>
              <div class="capital-dot dot-ro"></div>
              <div class="capital-dot dot-to"></div>

              <!-- Nordeste -->
              <div class="capital-dot dot-ma"></div>
              <div class="capital-dot dot-pi"></div>
              <div class="capital-dot dot-ce"></div>
              <div class="capital-dot dot-rn"></div>
              <div class="capital-dot dot-pb"></div>
              <div class="capital-dot dot-pe"></div>
              <div class="capital-dot dot-al"></div>
              <div class="capital-dot dot-se"></div>
              <div class="capital-dot dot-ba"></div>

              <!-- Centro-Oeste -->
              <div class="capital-dot dot-mt"></div>
              <div class="capital-dot dot-ms"></div>
              <div class="capital-dot dot-go"></div>
              <div class="capital-dot dot-df flash-main"></div>

              <!-- Sudeste -->
              <div class="capital-dot dot-mg"></div>
              <div class="capital-dot dot-es"></div>
              <div class="capital-dot dot-rj"></div>
              <div class="capital-dot dot-sp"></div>

              <!-- Sul -->
              <div class="capital-dot dot-pr"></div>
              <div class="capital-dot dot-sc"></div>
              <div class="capital-dot dot-rs"></div>

            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Search Bar Flutuante (Mantida) -->
  <section class="container search-container">
    <div class="search-card shadow-lg bg-white rounded-pill p-2">
      <div class="row g-0 align-items-center">

        <div class="col-md-7 border-end px-3">
          <div class="input-group input-group-lg border-0">
            <span class="input-group-text bg-transparent border-0 text-muted">
              <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <input type="text"
                   class="form-control border-0 shadow-none bg-transparent fw-medium"
                   placeholder="Busque por nome ou nome de urna..."
                   data-candidate-filter-target="search"
                   data-action="input->candidate-filter#filter">
          </div>
        </div>

        <div class="col-md-5 px-3">
          <div class="input-group input-group-lg border-0">
            <span class="input-group-text bg-transparent border-0 text-muted">
              <i class="fa-solid fa-location-crosshairs"></i>
            </span>
            <select class="form-select border-0 shadow-none bg-transparent text-muted fw-medium"
                    data-candidate-filter-target="state"
                    data-action="change->candidate-filter#filter">
              <option value="">Filtre por Estado</option>
              <% @states.each do |state| %>
                <option value="<%= state %>"><%= state %></option>
              <% end %>
            </select>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Grid de Cartões (Exatamente como a imagem de inspiração) -->
  <section class="container py-5 mt-4">
    <div class="row g-4">

      <% @candidates.each do |candidate| %>
        <div class="col-md-6 col-xl-4"
             data-candidate-filter-target="card"
             data-filter-name="<%= [candidate.name, candidate.ballot_name].compact.join(' ').downcase %>"
             data-filter-state="<%= candidate.state_label %>">

          <%= link_to candidate_path(candidate), class: "text-decoration-none text-reset" do %>
            <div class="card inspiration-card h-100 bg-white">
              <div class="card-body p-4 d-flex align-items-center gap-4">

                <!-- Foto (Esquerda) -->
                <div class="inspiration-photo-wrapper flex-shrink-0">
                  <% if candidate.photo_file.present? %>
                    <%= image_tag candidate.photo_file, class: "inspiration-photo rounded-circle", alt: candidate.ballot_name %>
                  <% else %>
                    <div class="inspiration-photo-placeholder rounded-circle d-flex align-items-center justify-content-center">
                      <i class="fa-solid fa-user text-gold"></i>
                    </div>
                  <% end %>
                </div>

                <!-- Dados e Barras (Direita) -->
                <div class="inspiration-data flex-grow-1 min-w-0">
                  <h3 class="h6 fw-bold text-navy mb-1 text-truncate">
                    <%= candidate.ballot_name.presence || candidate.name %>
                  </h3>

                  <div class="d-flex align-items-center text-muted small mb-3">
                    <i class="fa-solid fa-location-dot me-2 text-gold"></i>
                    <%= candidate.state_label %> (Brasil)
                  </div>

                  <!-- Barra 1: Situação (Simulando o "Skills" da imagem) -->
                  <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="data-label text-muted">Situação</span>
                      <span class="data-value text-navy"><%= candidate.candidacy_status.presence || "Aguardando" %></span>
                    </div>
                    <div class="progress rounded-pill" style="height: 4px;">
                      <div class="progress-bar bg-gold" style="width: 100%"></div>
                    </div>
                  </div>

                  <!-- Barra 2: Número (Simulando o "Experience" da imagem) -->
                  <div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="data-label text-muted">Número</span>
                      <span class="data-value text-navy"><%= candidate.number %></span>
                    </div>
                    <div class="progress rounded-pill" style="height: 4px;">
                      <div class="progress-bar bg-navy" style="width: 100%"></div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>

    <!-- Empty State -->
    <div class="text-center py-5 d-none empty-state bg-white rounded-4 shadow-sm mt-4" data-candidate-filter-target="emptyState">
      <div class="mb-3">
        <i class="fa-solid fa-ghost fa-3x text-pastel-yellow"></i>
      </div>
      <h4 class="h5 text-navy fw-bold">Nenhum registro encontrado</h4>
      <p class="text-muted">Ajuste os filtros de estado ou tente outro nome.</p>
    </div>
  </section>
</div>
