<% if user_signed_in? %>
  <%# page_path: a Harpia sabe de qual candidato/partido a pergunta trata.
      turbo_submits_with: o Turbo desabilita o botão até a resposta chegar,
      evitando perguntas duplicadas, e depois abre a conversa no chat principal. %>
  <%= button_to chats_path,
        method: :post,
        params: { message: { content: question, page_path: request.fullpath } },
        data: { turbo_submits_with: "Estamos de olho..." },
        class: "btn btn-gold rounded-pill px-4 fw-bold" do %>
    <i class="fa-solid fa-robot me-2"></i>Perguntar à Harpia
  <% end %>
<% else %>
  <%= link_to new_user_session_path, class: "btn btn-outline-secondary rounded-pill px-4" do %>
    <i class="fa-solid fa-robot me-2"></i>Entre para perguntar à Harpia<%= internal_link_icon %>
  <% end %>
<% end %>
