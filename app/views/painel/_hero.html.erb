<section class="hero-section panel-hero position-relative overflow-hidden">
  <div class="hero-glow"></div>
  <div class="container position-relative z-1">
    <h1 class="display-5 fw-bolder text-white mb-2 letter-spacing-tight">
      <% palavras = local_assigns[:highlight].to_s.split %>
      <% conectivos = palavras.take_while { |p| %w[a o as os da de do das dos e em na no nas nos para por com].include?(p.downcase) } %>
      <% destaque = palavras.drop(conectivos.size) %>
      <%= title %><% if conectivos.any? %> <%= conectivos.join(" ") %><% end %><% if destaque.any? %> <span class="text-gold"><%= destaque.join(" ") %></span><% end %>
    </h1>
    <% if local_assigns[:subtitle] %>
      <p class="lead text-white-50 mb-0" style="max-width: 520px;"><%= subtitle %></p>
    <% end %>
  </div>
</section>
