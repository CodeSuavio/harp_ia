<% meta title: "Meus chats" %>
<div class="chats-wrapper">

  <!-- ========================================== -->
  <!-- HERO SECTION: CABEÇALHO DOS CHATS -->
  <!-- ========================================== -->
  <section
    class="hero-section position-relative overflow-hidden d-flex align-items-center"
    style="padding: 5rem 0 7rem 0;">

    <div class="hero-glow"></div>

    <div class="container hero-content position-relative z-1 text-center">

      <div class="mb-3">
        <i class="fa-solid fa-robot fa-2x text-gold"></i>
      </div>

      <h1 class="display-5 fw-bolder text-white mb-3 letter-spacing-tight">
        Meus <span class="text-gold">Chats</span>
      </h1>

      <p
        class="lead text-white-50 mx-auto mb-4"
        style="max-width: 500px;">

        O seu histórico de investigações e conversas com a inteligência artificial da Harpia.

      </p>

      <!-- Botão Novo Chat Principal -->
      <%= button_to chats_path,
              method: :post,
              class: "btn btn-gold rounded-pill px-4 py-2 fw-bold text-uppercase d-inline-flex align-items-center shadow-sm",
              data: { turbo_submits_with: "Criando..." } do %>

        <i class="fa-solid fa-plus me-2"></i>
        Novo Chat

      <% end %>

    </div>
  </section>

  <!-- ========================================== -->
  <!-- GRID DE CONVERSAS E ESTADO VAZIO -->
  <!-- ========================================== -->
  <section
    class="container position-relative"
    style="margin-top: -3.5rem; z-index: 10; margin-bottom: 5rem;">

    <!-- Busca por título ou por algo mencionado na conversa -->
    <% if @query.present? || @chats.any? %>
      <%= form_with url: chats_path, method: :get,
                    data: {
                      turbo_frame: "chats_results",
                      turbo_action: "advance",
                      controller: "filter-form",
                      action: "input->filter-form#submit"
                    },
                    class: "card search-card shadow-lg bg-white rounded-4 p-3 border-0 mb-4" do %>
        <div class="input-group border-0">
          <span class="input-group-text bg-transparent border-0 text-muted ps-2">
            <i class="fa-solid fa-magnifying-glass text-gold fa-lg"></i>
          </span>
          <%= search_field_tag :q, @query,
                id: "chat-search",
                placeholder: "Buscar por título ou assunto da conversa...",
                aria: { label: "Buscar nos meus chats" },
                class: "form-control form-control-lg border-0 shadow-none bg-transparent fw-medium" %>
        </div>
      <% end %>
    <% end %>

    <%= turbo_frame_tag "chats_results", target: "_top" do %>
      <!--
        Esta div funciona como alvo para o Turbo.

        Quando um novo chat for criado pelo widget,
        poderemos atualizar apenas esta área da página,
        sem precisar fazer refresh completo.

        Durante uma busca ela muda de id, para que essas atualizações
        (que trazem todos os chats) não desfaçam o resultado na tela.
      -->
      <div id="<%= @query.present? ? "chats_search_results" : "chats_list" %>">
        <%= render "chats_list", chats: @chats, query: @query, mentions: @mentions %>
      </div>
    <% end %>

  </section>

</div>
