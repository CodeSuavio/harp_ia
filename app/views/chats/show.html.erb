<h1>Chat</h1>

<div class="chat-messages">
 <% @messages.each do |message| %>
    <% if message.role == "user" %>
      <div class="user-message">
        <%= message.content %>
      </div>
    <% else %>
      <div class="assistant-message">
        <%= render_markdown(message.content) %>
      </div>
    <% end %>
  <% end %>
</div>



<%= form_with model: [@chat, @message], class: "chat-form" do |form| %>
  <%= form.text_area :content, placeholder: "Digite sua mensagem...", class: "chat-input" %>
  <%= form.submit "Enviar", class: "chat-submit" %>
<% end %>
