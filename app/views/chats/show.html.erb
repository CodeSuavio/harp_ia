<% meta title: "Chat com a Harpia" %>
<div class="chat-wrapper">

  <!-- ========================================== -->
  <!-- HERO SECTION: CABEÇALHO DO CHAT -->
  <!-- ========================================== -->
  <section class="hero-section position-relative overflow-hidden d-flex align-items-center" style="padding: 3rem 0 5rem 0; min-height: auto;">
    <div class="hero-glow" style="width: 400px; height: 400px; opacity: 0.5;"></div>
    <div class="container hero-content position-relative z-1">
      <div class="d-flex align-items-center justify-content-between">

        <div class="d-flex align-items-center">
          <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
            <i class="fa-solid fa-robot fa-lg text-gold"></i>
          </div>
          <div>
            <!-- Atualizado pelo Turbo Stream quando a Harpia gera o título -->
            <h1 id="<%= dom_id(@chat, :title) %>" class="h3 fw-bolder text-white mb-0 letter-spacing-tight"><%= @chat.title.presence || Chat::DEFAULT_TITLE %></h1>
            <p class="text-white-50 small mb-0">Harpia Intelligence Analyst</p>
          </div>
        </div>

        <div>
          <%= link_to chats_path, class: "btn btn-sm btn-outline-light rounded-pill px-3" do %>
            <i class="fa-solid fa-arrow-left me-1"></i> Voltar
          <% end %>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- ÁREA DE MENSAGENS -->
  <!-- ========================================== -->
  <section class="container position-relative" style="margin-top: -3rem; z-index: 10; margin-bottom: 7rem;">
    <div
      class="card border-0 shadow-lg bg-white rounded-4 inspiration-card overflow-hidden"
      data-controller="chat"
      data-action="<%= ChatsHelper::CHAT_ACTIONS %>">

      <!-- Recebe pelo WebSocket a resposta da Harpia e o título da conversa
        (ChatResponseJob). Fica fora do Turbo Frame para continuar conectado
        enquanto a conversa é atualizada. -->
      <%= turbo_stream_from @chat %>

      <!-- Aparência das mensagens exibidas pelo chat_controller
        enquanto a Harpia processa a resposta. -->
      <template data-chat-target="userMessageTemplate">
        <%= render "chats/user_message" do %><% end %>
      </template>

      <template data-chat-target="loadingTemplate">
        <%= render "chats/assistant_message", loading: true %>
      </template>

      <template data-chat-target="errorTemplate">
        <%= render "chats/assistant_message", error: true do %>
          <%= ChatResponder::AI_ERROR_MESSAGE %>
        <% end %>
      </template>

      <!--
        O Turbo Frame contém as mensagens e o formulário. A cada pergunta,
        o Rails devolve um Turbo Stream que atualiza somente esta área
        e o título, sem recarregar a página.

        target="_top": links das respostas (ex.: "Ver ranking completo")
        abrem a página inteira; o formulário aponta para o próprio frame.
      -->
      <%= turbo_frame_tag ChatResponder::CONVERSATION_FRAME, target: "_top", class: "d-block" do %>
        <%= render "chats/conversation", chat: @chat, error_message: flash[:chat_error] %>
      <% end %>

    </div>
  </section>

</div>
