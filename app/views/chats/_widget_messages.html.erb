<%#
  Conversa do widget. Renderizada ao enviar uma pergunta
  (ChatResponder#widget_streams) e pelo WebSocket quando a resposta
  da Harpia fica pronta (ChatResponseJob).

  O widget não sabe qual conversa vai exibir até a primeira pergunta,
  por isso assina o canal da conversa aqui dentro.
%>
<% awaiting = chat.awaiting_response? %>

<div id="<%= dom_id(chat, :widget) %>" class="chat-widget-conversation">
<%= turbo_stream_from chat %>

<div
  class="chat-widget-messages"
  data-chat-target="messages"
  <%= chat_pending_data(chat, awaiting) %>>

  <% messages = chat.messages.order(:created_at).to_a %>
  <% messages.each do |message| %>

    <% if message.role == "user" %>

      <!--
        Mensagem enviada pelo usuário.
        O target "userMessage" permite que o Stimulus encontre
        a pergunta mais recente e posicione o scroll nela.
      -->
      <div
        class="chat-widget-user-message"
        data-chat-target="userMessage">
        <%= message.content %>
      </div>

      <!-- Enquanto a Harpia responde, ou quando ela não conseguiu responder -->
      <% if message.awaiting_response? %>
        <div class="chat-widget-loading" data-chat-loading>Estamos de olho...</div>
      <% elsif message.response_failed? %>
        <div class="chat-widget-error"><%= ChatResponder::AI_ERROR_MESSAGE %></div>
      <% end %>

    <% else %>

      <!--
        Resposta gerada pela Harpia.
        Quando a pergunta está fora do escopo, adiciona uma classe
        específica para diferenciá-la visualmente.
      -->
      <div class="chat-widget-assistant-message <%= 'chat-widget-assistant-message--out-of-scope' if message.out_of_scope? %>">
        <%= render_markdown(message.content) %>
      </div>

      <% if message == messages.last %>
        <%= render "chats/actions", actions: message.actions, css_class: "chat-quick-replies--widget" %>
      <% end %>

    <% end %>

  <% end %>

   <!-- Exibe uma mensagem amigável quando a IA não consegue responder. -->
   <% if local_assigns[:error_message].present? %>
      <div class="chat-widget-error">
        <%= error_message %>
      </div>
   <% end %>

</div>

<!--
  Depois da primeira pergunta, o Chat já existe.

  As próximas mensagens são enviadas para esse mesmo Chat,
  permitindo continuar a conversa sem criar um novo Chat.
-->
<%= render "chats/widget_form", url: chat_messages_path(chat), disabled: awaiting %>
</div>
