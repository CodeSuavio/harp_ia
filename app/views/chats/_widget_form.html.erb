<!--
  Formulário do widget. Antes da primeira pergunta ainda não existe um Chat,
  portanto envia para POST /chats; depois, para as mensagens desse Chat.
-->
<%= form_with url: url,
      method: :post,
      class: "chat-widget-input",
      data: chat_form_data(ChatResponder::WIDGET_FRAME) do %>

  <!-- Preenchido pelo Stimulus com a página atual, para a Harpia
     saber o que o usuário está vendo ao fazer a pergunta. -->
  <%= hidden_field_tag "message[page_path]", nil, id: nil %>

  <%= text_field_tag "message[content]",
      nil,
      placeholder: "Pergunte à Harpia...",
      autocomplete: "off",
      disabled: local_assigns[:disabled],
      data: { chat_target: "input" } %>

  <%= button_tag type: "submit", disabled: local_assigns[:disabled] do %>
    ➤
  <% end %>

<% end %>
