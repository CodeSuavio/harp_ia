<% chips = {
     "q"        => params[:q].presence,
     "year"     => params[:year].presence,
     "theme"    => (@themes.find { |t| t.id.to_s == params[:theme].to_s }&.name if params[:theme].present?),
     "approval" => ({ "1" => "Aprovadas", "0" => "Rejeitadas" }[params[:approval]]),
     "all"      => (params[:all] == "1" ? "Com e sem votos nominais" : nil)
   }.compact %>

<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
  <span class="data-label text-muted me-2">
    <%= @total %> <%= @total == 1 ? "votação" : "votações" %>
  </span>

  <% chips.each do |key, label| %>
    <%= link_to polls_path(request.query_parameters.except(key, "page")),
          data: { turbo_frame: "_top" },
          class: "panel-chip" do %>
      <%= label %> &times;
    <% end %>
  <% end %>

  <% if chips.any? %>
    <%= link_to "Limpar tudo", polls_path,
          data: { turbo_frame: "_top" },
          class: "small text-gold text-decoration-none fw-semibold ms-1" %>
  <% end %>
</div>

<% if @polls.empty? %>
  <%= render "painel/empty_state" %>
<% else %>
  <div class="row g-4">
    <%= render partial: "painel/poll_card", collection: @polls, as: :poll,
               locals: { tallies: @tallies } %>
  </div>

  <%= render "painel/pagination", path_helper: :polls_path %>
<% end %>
