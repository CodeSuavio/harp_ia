<% chips = {
     "q"     => params[:q].presence,
     "year"  => params[:year].presence,
     "theme" => (@themes.find { |t| t.id.to_s == params[:theme].to_s }&.name if params[:theme].present?),
     "party" => (@parties.find { |p| p.id.to_s == params[:party].to_s }&.label if params[:party].present?)
   }.compact %>

<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
  <span class="data-label text-muted me-2">
    <%= @total %> <%= @total == 1 ? "projeto" : "projetos" %>
  </span>

  <% chips.each do |key, label| %>
    <%= link_to bills_path(request.query_parameters.except(key, "page")),
          data: { turbo_frame: "_top" },
          class: "panel-chip" do %>
      <%= label %> &times;
    <% end %>
  <% end %>

  <% if chips.any? %>
    <%= link_to "Limpar tudo", bills_path,
          data: { turbo_frame: "_top" },
          class: "small text-gold text-decoration-none fw-semibold ms-1" %>
  <% end %>
</div>

<% if @bills.empty? %>
  <%= render "painel/empty_state" %>
<% else %>
  <div class="row g-4">
    <%= render partial: "painel/bill_card", collection: @bills, as: :bill %>
  </div>

  <%= render "painel/pagination", path_helper: :bills_path %>
<% end %>
