<% words = @bill.keywords.to_s.split(";").map(&:strip).reject(&:blank?) %>

<section class="container py-5" style="max-width: 860px;">
  <%= link_to "← Projetos", bills_path, class: "small text-muted text-decoration-none" %>

  <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mb-3">
    <span class="data-label text-muted"><%= @bill.submission_date&.strftime("%d/%m/%Y") %></span>
    <span class="panel-chip"><%= @bill.party&.label %></span>
    <% @bill.themes.each do |theme| %>
      <span class="panel-chip"><%= theme.name %></span>
    <% end %>
  </div>

  <p class="fs-5 fw-semibold text-navy"><%= @bill.summary %></p>

  <p class="text-muted">
    Autoria:
    <%= link_to @bill.deputy.name, deputy_path(@bill.deputy), class: "text-navy fw-semibold" %>
    · Proposição nº <%= @bill.bill_number %>
  </p>

  <% if words.any? %>
    <h2 class="h6 text-uppercase text-muted mt-4">Palavras-chave</h2>
    <div class="d-flex flex-wrap gap-2 mb-4">
      <% words.each do |word| %>
        <%= link_to word, bills_path(q: word), class: "panel-chip text-decoration-none" %>
      <% end %>
    </div>
  <% end %>

  <% if @bill.url.present? %>
    <%= link_to "Ver tramitação na Câmara", @bill.url, target: "_blank", rel: "noopener",
          class: "btn btn-outline-dark rounded-pill" %>
  <% end %>
</section>
