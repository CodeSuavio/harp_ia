<% meta title: "Projetos de lei", description: "Propostas apresentadas na Câmara dos Deputados em 2026 e as de anos anteriores que foram à votação, com autores e temas." %>
<%= render "painel/hero", title: "Projetos", highlight: "e propostas",
      subtitle: "Propostas apresentadas na Câmara em 2026 e as de anos anteriores que foram à votação." %>

<section class="container search-container pb-5">
  <%= turbo_frame_tag "bills_list", data: { turbo_action: "advance" } do %>
    <%= form_with url: bills_path, method: :get,
                  data: {
                    controller: "filter-form",
                    action: "input->filter-form#submit change->filter-form#submit"
                  },
                  class: "card search-card shadow-lg bg-white rounded-4 p-3 border-0 mb-4" do %>

      <!-- LINHA 1: Barra de Pesquisa -->
      <div class="row g-0 border-bottom pb-2 mb-2">
        <div class="col-12 px-2">
          <div class="input-group border-0">
            <span class="input-group-text bg-transparent border-0 text-muted ps-2">
              <i class="fa-solid fa-magnifying-glass text-gold fa-lg"></i>
            </span>
            <%= text_field_tag :q, params[:q],
                  id: "bill-search",
                  placeholder: "Assunto ou número (ex.: PL 1822)...",
                  aria: { label: "Buscar projetos" },
                  class: "form-control form-control-lg border-0 shadow-none bg-transparent fw-medium",
                  data: { turbo_permanent: true } %>
          </div>
        </div>
      </div>

      <!-- LINHA 2: Filtros de Seleção -->
      <div class="row g-0 align-items-center">
        <!-- Filtro: Ano -->
        <div class="col-md-6 border-end-lg px-2 py-2">
          <div class="input-group border-0">
            <span class="input-group-text bg-transparent border-0 text-muted" title="Ano">
              <i class="fa-solid fa-calendar text-gold"></i>
            </span>
            <%= select_tag :year,
                  options_for_select([["Todos os anos", ""]] + @years.map { |y| [y, y] }, params[:year]),
                  aria: { label: "Ano" },
                  class: "form-select border-0 shadow-none bg-transparent text-muted fw-medium" %>
          </div>
        </div>

        <!-- Filtro: Tema -->
        <div class="col-md-6 px-2 py-2">
          <div class="input-group border-0">
            <span class="input-group-text bg-transparent border-0 text-muted" title="Tema">
              <i class="fa-solid fa-tags text-gold"></i>
            </span>
            <%= select_tag :theme,
                  options_for_select(
                    [["Todos os temas", ""]] + @themes.map { |t| ["#{t.name} (#{@theme_counts[t.id].to_i})", t.id] },
                    params[:theme]
                  ),
                  aria: { label: "Tema" },
                  class: "form-select border-0 shadow-none bg-transparent text-muted fw-medium" %>
          </div>
        </div>

        <!-- Filtro: Partido -->
        <div class="col-md-6 border-end-lg px-2 py-2">
          <div class="input-group border-0">
            <span class="input-group-text bg-transparent border-0 text-muted" title="Partido">
              <i class="fa-solid fa-flag text-gold"></i>
            </span>
            <%= select_tag :party,
                  options_for_select([["Todos os partidos", ""]] + @parties.select { |p| @party_counts[p.id].to_i.positive? || params[:party].to_s == p.id.to_s }.map { |p| ["#{p.label} (#{@party_counts[p.id].to_i})", p.id] }, params[:party]),
                  aria: { label: "Partido" },
                  class: "form-select border-0 shadow-none bg-transparent text-muted fw-medium" %>
          </div>
        </div>

        <!-- Filtro: Tipo -->
        <div class="col-md-6 px-2 py-2">
          <div class="input-group border-0">
            <span class="input-group-text bg-transparent border-0 text-muted" title="Tipo">
              <i class="fa-solid fa-file-lines text-gold"></i>
            </span>
            <%= select_tag :type,
                  options_for_select(tipos_de_proposicao([["Todos os tipos", ""]] + @types.select { |t| @type_counts[t].to_i.positive? || params[:type] == t }.map { |t| [t, t] }).map { |label, value| value.present? ? [label.sub(/\A(\S+)/) { "#{$1} (#{@type_counts[value].to_i})" }, value] : [label, value] }, params[:type]),
                  aria: { label: "Tipo" },
                  class: "form-select border-0 shadow-none bg-transparent text-muted fw-medium" %>
          </div>
          <%= hidden_field_tag :author, params[:author] if params[:author].present? %>
        </div>
      </div>
    <% end %>

    <%= render "list" %>
  <% end %>
</section>
