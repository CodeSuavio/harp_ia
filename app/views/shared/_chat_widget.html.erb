<%#
  data-turbo-permanent: o widget (aberto ou fechado, com a conversa) continua
  na tela ao navegar, por exemplo ao clicar em "Ver ranking completo".
  O id muda com o usuário, para não manter a conversa depois de sair da conta.
%>
<div
  id="chat_widget_<%= current_user&.id || 'guest' %>"
  class="chat-widget"
  data-turbo-permanent
  data-controller="chat-widget chat"
  data-action="chat-widget:opened->chat#scrollToLatestInteraction <%= ChatsHelper::CHAT_ACTIONS %>">

  <!-- Botão flutuante que abre o chatbot -->
  <button
    class="chat-widget-button"
    type="button"
    aria-label="Abrir assistente Estamos de Olho"
    data-chat-widget-target="button"
    data-action="click->chat-widget#open">

    <%= image_tag "chatbot-logo.png",
        class: "chat-widget-logo",
        alt: "" %>
  </button>

  <!-- Janela do chatbot -->
  <div
    class="chat-widget-window"
    hidden
    data-chat-widget-target="window">

    <!-- Cabeçalho -->
    <div class="chat-widget-header">
      <div class="chat-widget-title">

        <%= image_tag "chatbot-logo.png",
            class: "chat-widget-header-logo",
            alt: "" %>

        <span>Estamos de Olho</span>
      </div>

      <button
        class="chat-widget-close"
        type="button"
        aria-label="Fechar assistente"
        data-action="click->chat-widget#close">
        ×
      </button>
    </div>

    <!-- Aparência das mensagens exibidas pelo chat_controller
      enquanto a Harpia processa a resposta. -->
    <template data-chat-target="userMessageTemplate">
      <div class="chat-widget-user-message" data-chat-target="userMessage"></div>
    </template>

    <template data-chat-target="loadingTemplate">
      <div class="chat-widget-loading" data-chat-loading>Estamos de olho...</div>
    </template>

    <template data-chat-target="errorTemplate">
      <div class="chat-widget-error"><%= ChatResponder::AI_ERROR_MESSAGE %></div>
    </template>

    <!--
      O Turbo Frame contém tanto as mensagens quanto o formulário.

      Antes da primeira pergunta ainda não existe um Chat,
      portanto o formulário envia para POST /chats.
    -->
    <%# target="_top": links das respostas abrem a página inteira;
        os formulários apontam para o próprio frame. %>
    <%= turbo_frame_tag ChatResponder::WIDGET_FRAME, target: "_top" do %>

      <!-- Área das mensagens -->
      <% if user_signed_in? %>
        <div class="chat-widget-messages" data-chat-target="messages">
          <p>Olá! O que você gostaria de saber?</p>
        </div>

        <!-- Formulário da primeira pergunta
          Usuários autenticados podem iniciar uma nova conversa
          diretamente pelo widget.-->
        <%= render "chats/widget_form", url: chats_path %>

      <% else %>

        <!-- Estado do widget para usuários não autenticados -->

        <div class="chat-widget-login-required">
           <div class="chat-widget-login-icon">
            <i class="fa-solid fa-comments text-gold"></i>
          </div>

          <h3>Olá!</h3>

          <p class="chat-widget-login-question">
            O que você gostaria de saber?
          </p>

          <div class="chat-widget-login-divider"></div>
          <div class="chat-widget-login-lock">
            <i class="fa-solid fa-lock"></i>
          </div>

          <p class="chat-widget-login-message">
            Entre na sua conta para conversar com a Harpia.
          </p>

          <%= link_to new_user_session_path,
              class: "chat-widget-login-button",
              data: { turbo_frame: "_top" } do %>
            Entrar
            <i class="fa-solid fa-arrow-right"></i>
          <% end %>
        </div>


      <% end %> <!-- fecha if user_signed_in? -->

    <% end %>   <!-- fecha turbo_frame_tag -->

  </div>

</div>
