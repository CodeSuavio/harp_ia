<!-- FOOTER DA PÁGINA (PARTIAL) -->
<!-- ========================================== -->
<footer class="custom-footer mt-5">
  <div class="container pt-5 pb-4">
    <div class="row align-items-center">

      <!-- Coluna vazia: mantém os links no centro e o copyright à direita -->
      <div class="col-lg-3 d-none d-lg-block"></div>

      <!-- Links Úteis: lado a lado, numa linha só -->
      <div class="col-md-8 col-lg-6 mb-3 mb-md-0">
        <div class="footer-links d-flex justify-content-center">
          <a href="#onboarding-modal" data-bs-toggle="modal">Como funciona</a>
          <a href="#" data-hints-reset>Rever dicas</a>
          <%= link_to "Sobre Nós", about_path %>
          <%= link_to "Contato", contact_path %>
        </div>
      </div>

      <!-- Direitos Reservados e Ano Dinâmico -->
      <div class="col-md-4 col-lg-3 text-center text-md-end footer-copyright">
        &copy; <%= Time.current.year %> HarpIA. <br class="d-md-none">
        Todos os direitos reservados.
      </div>

    </div>
  </div>
</footer>
