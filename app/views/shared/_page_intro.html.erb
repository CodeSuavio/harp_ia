<% if (tour = page_tour) %>
  <% key, steps = tour %>
  <div data-controller="page-tour"
       data-page-tour-key-value="<%= key %>"
       data-page-tour-steps-value="<%= steps.to_json %>"></div>
  <style>
    .tour-target { outline: 3px solid #f2b705; outline-offset: 4px; border-radius: .5rem; transition: outline-color .2s; }
    .tour-popover { max-width: 290px; box-shadow: 0 .5rem 1.5rem rgba(0, 0, 0, .18); border: 0; }
    .tour-popover .popover-body { padding: .85rem 1rem; }
  </style>
<% end %>
