<div class="container my-4">
  <%= link_to "← Partidos", parties_path %>

  <h1 class="mt-3"><%= @party.label %></h1>
  <p class="lead"><%= @party.name %></p>
  <% if @party.url.present? %>
    <p><%= link_to "Site oficial", @party.url, target: "_blank", rel: "noopener" %></p>
  <% end %>

  <h2 class="h4 mt-4">Deputados</h2>
  <% if @party.deputies.empty? %>
    <p class="text-muted">Nenhum deputado deste partido.</p>
  <% else %>
    <ul class="list-group">
      <% @party.deputies.each do |deputy| %>
        <li class="list-group-item">
          <%= link_to deputy.name, deputy_path(deputy) %> · <%= deputy.state_label %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
