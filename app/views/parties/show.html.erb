<% page_title = "#{@party.label} · #{@party.name}" %>
<% page_description = "Bancada, votações, gastos, projetos e candidatos de #{@party.label} na Câmara dos Deputados." %>
<% federation = @stats.federation %>
<% leader = @party.leader %>
<% content_for :title, "#{page_title} · Harpia" %>
<% content_for :head do %>
  <meta name="description" content="<%= page_description %>">
  <meta property="og:title" content="<%= page_title %>">
  <meta property="og:description" content="<%= page_description %>">
  <meta property="og:url" content="<%= party_url(@party) %>">
<% end %>

<div class="container py-5">
  <!-- Botão Voltar -->
  <div class="mb-4">
    <%= link_to parties_path, class: "text-decoration-none text-muted fw-medium transition" do %>
      <i class="fa-solid fa-arrow-left me-2"></i> Voltar para Partidos
    <% end %>
  </div>

  <!-- Cabeçalho do Partido -->
  <div class="card inspiration-card shadow-sm border-0 rounded-4 p-4 bg-white mb-4">
    <div class="d-flex flex-column flex-md-row align-items-center align-items-md-start gap-4">
      <div class="party-avatar rounded-4 bg-light d-flex flex-column align-items-center justify-content-center shadow-sm">
        <% if @party.number.present? %>
          <span class="display-5 fw-bold text-gold lh-1"><%= @party.number %></span>
          <span class="small text-muted text-uppercase tracking-wider mt-1">nº na urna</span>
        <% else %>
          <i class="fa-solid fa-flag fa-3x text-gold"></i>
        <% end %>
      </div>

      <div class="flex-grow-1 text-center text-md-start min-w-0">
        <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-3 mb-1">
          <% if @party.logo_url.present? %>
            <%= image_tag @party.logo_url, class: "party-logo", alt: "Logo do #{@party.label}", loading: "lazy" %>
          <% end %>
          <h1 class="h2 fw-bold text-navy mb-0"><%= @party.label %></h1>
        </div>
        <p class="text-muted mb-3"><%= @party.name %></p>

        <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-md-start mb-3">
          <% if federation %>
            <div class="badge badge-wrap bg-navy text-white px-3 py-2 fw-medium tracking-wider"
                 title="Federação que orienta em conjunto na Câmara">
              <i class="fa-solid fa-handshake me-1 text-gold"></i> Federação <%= federation[:label] %>
            </div>
          <% end %>
          <% if @party.registered_on.present? %>
            <div class="badge badge-wrap bg-light text-navy border px-3 py-2 fw-medium tracking-wider">
              <i class="fa-solid fa-calendar me-1 text-gold"></i> Registro no TSE em <%= @party.registered_on.year %>
            </div>
          <% end %>
          <% if leader || @party.leader_name.present? %>
            <div class="badge badge-wrap bg-light text-navy border px-3 py-2 fw-medium tracking-wider">
              <i class="fa-solid fa-user-tie me-1 text-gold"></i> Líder:
              <% if leader %>
                <%= link_to leader.name, deputy_path(leader), class: "text-navy" %>
              <% else %>
                <%= @party.leader_name %>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
          <%= render "painel/ask_harpia", question: party_harpia_question(@party, @stats) %>
          <%= link_to compare_parties_path, class: "btn btn-light border rounded-pill px-4 fw-medium text-navy" do %>
            <i class="fa-solid fa-scale-balanced me-2 text-gold"></i> Comparar com outros partidos
          <% end %>
          <% if @party.url.present? %>
            <%= link_to @party.url.start_with?("http") ? @party.url : "https://#{@party.url}", target: "_blank", rel: "noopener",
                  class: "btn btn-light border rounded-pill px-4 fw-medium text-navy" do %>
              <i class="fa-solid fa-globe me-2 text-gold"></i> Site oficial
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# target _top: links para deputados e votações saem do frame; só as abas trocam o conteúdo %>
  <%= turbo_frame_tag "party_tab", class: "d-block", target: "_top", data: { turbo_action: "advance" } do %>
    <!-- Abas -->
    <ul class="nav nav-pills deputy-tabs flex-nowrap overflow-auto mb-4 gap-2">
      <% PartiesController::TABS.each do |key, label| %>
        <li class="nav-item">
          <%= link_to label, party_tab_path(@party, key),
                class: "nav-link rounded-pill text-nowrap #{'active' if key == @tab}",
                aria: { current: ("page" if key == @tab) },
                data: { turbo_frame: "party_tab" } %>
        </li>
      <% end %>
    </ul>

    <%= render "parties/tabs/#{@tab}" %>
  <% end %>
</div>
